# Copy to .env and fill in values.

DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=5050
# Must match NEXT_PUBLIC_API_URL in web/.env.local (no trailing /api)
PUBLIC_BASE_URL="http://127.0.0.1:5050"

# Supabase — Settings → API (leave empty to fall back to local disk uploads)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_PUBLIC_KEY=your-anon-public-key
SUPABASE_STORAGE_URL=https://your-project-id.supabase.co/storage/v1

# Optional bucket names (defaults: videos, thumbnails)
# SUPABASE_VIDEO_BUCKET=videos
# SUPABASE_THUMBNAIL_BUCKET=thumbnails

# Set false after migrating all media to Supabase
SERVE_LOCAL_UPLOADS=true
